# Rendered by the nginx image at start-up (envsubst): ${API_UPSTREAM} comes from the environment.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 10m;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

  # The API trusts exactly one proxy hop (this one) for client IPs and rate limits. If another proxy terminates HTTPS
  # in front of this container, let it set the client IP here, e.g.:
  #   set_real_ip_from 10.0.0.0/8;  real_ip_header X-Forwarded-For;
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
  }
  location /files/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
  }
  location = /health {
    proxy_pass ${API_UPSTREAM};
  }
  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # Hashed build files never change: cache for a year. Everything else must be revalidated so a deploy shows up.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }
  location ~ ^/(sw\.js|registerSW\.js|workbox-.*\.js|manifest\.webmanifest)$ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
  }
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
